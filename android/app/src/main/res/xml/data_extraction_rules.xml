<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : ni sauvegarde dans le cloud ni transfert d'appareil à appareil (le jeton de connexion et les données
     personnelles restent sur l'appareil). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
